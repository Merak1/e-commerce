datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
  // url      = env("DATABASE_URL_PROD")
}

generator client {
  provider        = "prisma-client-js"
}

model Account {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.String
  access_token       String?  @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.String
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}


model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  hashedPassword String?
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  role Role @default(USER)


  accounts      Account[]
  orders        Order[]//works
}
model Sale {
  id String @id  @default(auto()) @map("_id") @db.ObjectId
  active Boolean
  porcentage Int
  product Product@relation(fields: [productId], references: [id])
  productId String @db.ObjectId

}
model Image {// CATEGORIES 
  id String @id  @default(auto()) @map("_id") @db.ObjectId
  color String
  colorCode String
  image String
  name String
  productIDs String[] @db.ObjectId
  products   Product[]   @relation(fields: [productIDs], references: [id])
}

model Product { // POST 
  id String @id  @default(auto()) @map("_id") @db.ObjectId
  imageIDs String[] @db.ObjectId
  images  Image[] @relation(fields: [imageIDs], references: [id])
  name String
  description String
  price Float
  brand String
  category String
  inStock Boolean
  sku String
  model String
  createDate DateTime @default(now())
  packageInfo Package
  productType ProductType
  sales Sale[]
  orderIds String[] @db.ObjectId
  orders Order[] @relation(fields: [orderIds], references: [id])
}


model Order { //order has products
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String @db.ObjectId
  amount        Float 
  currency      String
  status        String
  deliveryStatus String?
  createDate DateTime @default(now())
  paymentIntentId String @unique
  // products CartProductType[]
  addresses Address?
  shippingDetails ShippingDetail?
  productsIds String[] @db.ObjectId
  products Product[] @relation(fields: [productsIds], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

type ShippingDetail  {
success Boolean?
data ShippingDetailData?
order_id Int?
courier String?
}


type ShippingDetailData {
// success Boolean
// orderID Int
trackingNumber String
labelsNumber Int
amount Int
dataArray  Int[]
}

enum ProductType  {
  THERMOS
  CASE
}
 type CartProductType  {
  id String
  name String
  description String
  category String
  brand String
  selectedImage ImageType
  quantity Int
  price Float
  packageInfo Package
  productType ProductType
}
//npx prisma db push
type Package  {
  h Int
  w Int
  hh Int
  weight Int
  // sizeUnit String
  // weightUnit String 
  declaredValue Int
}
type ImageType {
  color String
  colorCode String
  image String
  name String
}

type Address {
  city String
  country String
  line1 String
  line2 String?
  postal_code String
  state String
}
enum Role {
    USER 
    ADMIN 
}